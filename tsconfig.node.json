{
  // Code run by Node: the Vite config, its plugins, and the tests. Tests run
  // through Node's type stripping, which needs `import type` for type-only
  // imports (verbatimModuleSyntax) and no TypeScript-only runtime syntax
  // (erasableSyntaxOnly). They exercise browser modules, hence the DOM lib.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "plugins", "src/**/*.test.ts", "src/**/*.d.ts"]
}
